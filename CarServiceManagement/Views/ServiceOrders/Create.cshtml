@model CarServiceManagement.Models.ServiceOrder

<h1>Novi radni nalog</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">Mušterija</label>
        <select asp-for="CustomerId"
                asp-items="ViewBag.Musterije"
                class="form-select">
            <option value="">Izaberite mušteriju</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VehicleId" class="form-label">Vozilo</label>
        <select asp-for="VehicleId"
                asp-items="ViewBag.Vozila"
                class="form-select">
            <option value="">Izaberite vozilo</option>
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Opis kvara i potrebne popravke</label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Cena (RSD)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Sačuvaj radni nalog</button>

    <a asp-action="Index" class="btn btn-secondary">Nazad</a>

</form>
