@model List<CarServiceManagement.Models.ServiceOrder>

<h1>Radni nalozi</h1>
<div class="row g-3 mb-4">

    <div class="col-md-3 col-6">
        <div class="card service-stat-card h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Ukupno naloga</p>
                <h3 class="fw-bold mb-0">
                    @ViewBag.UkupnoNaloga
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card service-stat-card h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Na čekanju</p>
                <h3 class="fw-bold text-warning mb-0">
                    @ViewBag.NaCekanju
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card service-stat-card h-100">
            <div class="card-body">
                <p class="text-muted mb-2">U toku</p>
                <h3 class="fw-bold text-primary mb-0">
                    @ViewBag.Utoku
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card service-stat-card h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Završeno</p>
                <h3 class="fw-bold text-success mb-0">
                    @ViewBag.Zavrseno
                </h3>
            </div>
        </div>
    </div>

</div>

<p>Pregled svih servisnih naloga u sistemu.</p>

<a asp-controller="ServiceOrders"
   asp-action="Create"
   class="btn btn-primary mb-3">
    + Novi radni nalog
</a>
<form asp-controller="ServiceOrders"
      asp-action="Index"
      method="get"
      class="d-flex gap-2 mb-4">

    <input type="text"
           name="pretraga"
           value="@ViewBag.Pretraga"
           class="form-control"
           placeholder="Pretraži mušteriju, vozilo ili registraciju..." />
    <select name="status" class="form-select">
        <option value="">Svi statusi</option>

        <option value="Na čekanju"
                selected="@(ViewBag.Status == "Na čekanju")">
            Na čekanju
        </option>

        <option value="U toku"
                selected="@(ViewBag.Status == "U toku")">
            U toku
        </option>

        <option value="Završen"
                selected="@(ViewBag.Status == "Završen")">
            Završen
        </option>
    </select>
    <select name="sortiranje" class="form-select">

        <option value="najnoviji"
                selected="@(ViewBag.Sortiranje != "najstariji")">
            Najnoviji prvo
        </option>

        <option value="najstariji"
                selected="@(ViewBag.Sortiranje == "najstariji")">
            Najstariji prvo
        </option>

    </select>
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-search"></i> Pretraži
    </button>

    <a asp-controller="ServiceOrders"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Poništi
    </a>

</form>

<table class="table">
    <thead>
        <tr>
            <th>Broj naloga</th>
            <th>Mušterija</th>
            <th>Vozilo</th>
            <th>Opis kvara</th>
            <th>Datum prijema</th>
            <th>Status</th>
            <th>Cena</th>
            <th>Akcije</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var nalog in Model)
        {
            <tr>
                <td>#@nalog.Id</td>
                <td>@(nalog.Customer?.FirstName ?? "") @(nalog.Customer?.LastName ?? "")</td>
                <td>@(nalog.Vehicle?.Brand ?? "") @(nalog.Vehicle?.Model ?? "")</td>
                <td>@nalog.Description</td>
                <td>@nalog.DateCreated.ToString("dd.MM.yyyy.")</td>
                <td>
                    @if (nalog.Status == "Na čekanju")
                    {
                        <span class="badge bg-warning text-dark">
                            Na čekanju
                        </span>
                    }
                    else if (nalog.Status == "U toku")
                    {
                        <span class="badge bg-primary">
                            U toku
                        </span>
                    }
                    else if (nalog.Status == "Završen")
                    {
                        <span class="badge bg-success">
                            Završen
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @nalog.Status
                        </span>
                    }
                </td>
                <td>@nalog.Price.ToString("N2") RSD</td>
                <td>
                    <a asp-controller="ServiceOrders"
                       asp-action="Details"
                       asp-route-id="@nalog.Id"
                       class="btn btn-info btn-sm">
                        Detalji
                    </a>

                    <a asp-controller="ServiceOrders"
                       asp-action="Edit"
                       asp-route-id="@nalog.Id"
                       class="btn btn-warning btn-sm">
                        Izmeni
                    </a>

                    <form asp-controller="ServiceOrders"
                          asp-action="Delete"
                          asp-route-id="@nalog.Id"
                          method="get"
                          style="display:inline">

                        <button type="submit" class="btn btn-danger btn-sm">
                            Obriši
                        </button>

                    </form>

                </td>

            </tr>
        }
    </tbody>
</table>
