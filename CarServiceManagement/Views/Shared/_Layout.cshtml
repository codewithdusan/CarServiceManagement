
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CarServiceManagement</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarServiceManagement.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-wrapper">

        <header class="main-header">
            <nav class="main-navbar">

                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">CS</span>
                    <span>CAR<span class="brand-highlight">SERVICE</span></span>
                </a>
                <div class="collapse navbar-collapse">

                    <ul class="nav-links">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                                Dashboard
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Customers"
                               asp-action="Index"
                               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")">
                                Mušterije
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Vehicles"
                                asp-action="Index"
                                class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "active" : "")">
                                Vozila
                            </a>
                        </li>
                        <li>
                            <a asp-controller="ServiceOrders"
                               asp-action="Index"
                               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceOrders" ? "active" : "")">
                                Radni nalozi
                            </a>
                        </li>

                    </ul>

                    <div class="navbar-status">
                        <span class="status-dot"></span>
                        Sistem aktivan
                    </div>

                </div>

            </nav>
        </header>

        <main class="main-content">
            @RenderBody()
        </main>

        <footer class="main-footer">
            <span>© 2026 CarServiceManagement</span>
            <span>Designed with <span class="brand-highlight">♥</span></span>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
